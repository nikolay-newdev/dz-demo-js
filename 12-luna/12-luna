const card = "4561-2612-1234-5464";

function correctCardNumber(cardNumber) {
  let res = cardNumber
    .replaceAll("-", "")
    .split("")
    .map((el, ix) => {
      let num = Number(el);
      ix % 2 == 0 ? (num = num * 2) : num;
      num > 9 ? (num -= 9) : num;
      return num;
    })
    .reduce((acc, elem) => (acc += elem), 0);

  return res % 10 === 0;
}

console.log(correctCardNumber(card));
